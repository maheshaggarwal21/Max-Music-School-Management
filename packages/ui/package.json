{
  "name": "@maxmusic/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design-system components for all MaxMusic panels. TypeScript+React source exports — consumed via Next.js transpilePackages, no build step.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/theme": "./src/lib/theme.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "motion": "^12.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
