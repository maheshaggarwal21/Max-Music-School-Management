# ─────────────────────────────────────────────────────────────────────────────
# MaxMusic Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# Dev A owns this file. All domains must come from env — never hardcode.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains (no trailing slash, no protocol for PLATFORM/OPERATOR) ───────────
PLATFORM_DOMAIN=platform.example.com
PLATFORM_DOMAIN_URL=https://platform.example.com
OPERATOR_DOMAIN=admin.example.com
OPERATOR_DOMAIN_URL=https://admin.example.com

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/maxmusic

# ── JWT Secrets (one per panel class — keep STRICTLY separate) ───────────────
# Use: openssl rand -hex 64
JWT_SECRET_OPERATOR=change_me_operator_secret_min_64_chars
JWT_SECRET_ADMIN=change_me_admin_secret_min_64_chars
JWT_SECRET_TEACHER=change_me_teacher_secret_min_64_chars
JWT_SECRET_STUDENT=change_me_student_secret_min_64_chars
JWT_SECRET_GOD=change_me_god_token_secret_min_64_chars
# Bridges the httpOnly/path-scoped panel cookie to the Socket.io handshake.
JWT_SECRET_SOCKET=change_me_socket_token_secret_min_64_chars

# ── JWT Expiry ────────────────────────────────────────────────────────────────
JWT_EXPIRES_OPERATOR=8h
JWT_EXPIRES_ADMIN=12h
JWT_EXPIRES_TEACHER=12h
JWT_EXPIRES_STUDENT=24h
JWT_EXPIRES_GOD=15m
JWT_EXPIRES_SOCKET=2m

# ── TOTP (Operator 2FA) ───────────────────────────────────────────────────────
TOTP_ISSUER=MaxMusicAdmin
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMTP / Nodemailer ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Timezone for the daily maintenance job (00:05 local). Default Asia/Kolkata.
CRON_TZ=Asia/Kolkata

# ── Seed (scripts/seed.js) ───────────────────────────────────────────────────
# Optional overrides for the first-run seed. Defaults are fine for development.
SEED_OPERATOR_EMAIL=admin@maxmusic.internal
SEED_OPERATOR_NAME=Super Admin
SEED_DEMO_INST=Demo Music School
SEED_DEMO_TEACHER_NAME=Demo Teacher
SEED_DEMO_TEACHER_MOBILE=9999999999
SEED_DEMO_TEACHER_EMAIL=teacher@demo.internal

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
