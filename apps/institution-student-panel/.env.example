# Institution student panel API base URL.
# Leave EMPTY to run in MOCK MODE (no backend required — src/lib/api.ts resolves
# mock data via the mockable() helper).
# In deploys, set to the API origin, e.g. https://api.<PLATFORM_DOMAIN>
# NEVER hardcode a domain in source — this env var is the only place it lives.
NEXT_PUBLIC_API_URL=

# Optional: pin the institution slug for single-tenant preview deploys.
# When unset, the slug is read from the first URL path segment
# (https://<PLATFORM_DOMAIN>/<slug>/student). Never hardcode in source.
NEXT_PUBLIC_INST_SLUG=
