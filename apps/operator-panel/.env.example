# Operator panel API base URL.
# Leave EMPTY to run in MOCK MODE (no backend required — src/lib/api.ts resolves
# mock data via the mockable() helper).
# In deploys, set to the API origin, e.g. https://api.<PLATFORM_DOMAIN>
# NEVER hardcode a domain in source — this env var is the only place it lives.
NEXT_PUBLIC_API_URL=

# Institution admin panel origin for the "open panel" (eye) action on
# /institutions. Leave EMPTY in local dev — falls back to
# <protocol>//<current-hostname>:3011. Unused once the real backend is wired:
# the impersonate endpoint (Dev A's P3-05) returns the god-token URL
# (https://<PLATFORM_DOMAIN>/<slug>/admin) and that is opened instead.
NEXT_PUBLIC_ADMIN_PANEL_URL=
