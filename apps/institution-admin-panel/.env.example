# Institution admin panel API base URL.
# Leave EMPTY to run in MOCK MODE (no backend required — src/lib/api.ts resolves
# mock data via the mockable() helper).
# In deploys, set to the API origin, e.g. https://api.<PLATFORM_DOMAIN>
# NEVER hardcode a domain in source — this env var is the only place it lives.
NEXT_PUBLIC_API_URL=

# Operator panel origin — where "Exit operator view" returns the superadmin.
# Only ever rendered inside an active operator session (never shown to
# institution users). Leave EMPTY in dev: falls back to <hostname>:3010.
NEXT_PUBLIC_OPERATOR_PANEL_URL=
